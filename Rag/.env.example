# Required
API_KEY=change-me
GEMINI_API_KEY=your-gemini-key

# Local Supabase (supabase start prints the DB URL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: keep original uploads in a private Supabase Storage bucket ("View original" in the UI).
# The secret key is in Supabase > Project Settings > API Keys. SUPABASE_URL defaults to DATABASE_URL's project.
# SUPABASE_SECRET_KEY=
# SUPABASE_URL=https://<project-ref>.supabase.co
# STORAGE_BUCKET=sources

# Optional
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
TOP_K=8
CHUNK_MAX_WORDS=500
TEMPERATURE=0.1
BULK_CONCURRENCY=3
BULK_K_PER_QUERY=6
BULK_MAX_CHUNKS=30
