# Judge (Claude). Leave unset to use the ANTHROPIC_API_KEY env var or an `ant auth login` profile.
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-opus-5-5
JUDGE_EFFORT=high

# Systems under test (start Rag/run.py and Wiki/run.py first)
RAG_URL=http://127.0.0.1:8000
RAG_API_KEY=change-me
WIKI_URL=http://127.0.0.1:8001
WIKI_API_KEY=change-me
# CLI runs only: the RAG collection and the wiki to compare (UI runs choose them)
RAG_COLLECTION=ifrs9
# CLI runs only: sources both systems may use, standard (Part A only) or all (Parts A, B and C)
SOURCES=all
WIKI_SLUG=ifrs9

# Results are stored in bench.runs (python -m bench.migrate)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# CLI only (UI runs upload these): human-written reference assessment (.docx), relative to Benchmark/ or absolute
REFERENCE_DOCX=../Docs/reference_assessment.docx

RUNS=3
CONCURRENCY=4
SEED=42
