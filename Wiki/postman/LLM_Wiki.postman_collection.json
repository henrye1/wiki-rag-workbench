        },
        {
          "name": "Delete source",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/wikis/{{wiki}}/sources/source-ecl-policy-memo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis",
