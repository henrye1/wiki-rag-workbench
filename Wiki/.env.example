# Required
API_KEY=change-me
GEMINI_API_KEY=your-gemini-key

# Same local Supabase DB as Rag (tables live in the "wiki" schema)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: keep original uploads in a private Supabase Storage bucket ("View original" in the UI).
# The secret key is in Supabase > Project Settings > API Keys. SUPABASE_URL defaults to DATABASE_URL's project.
# SUPABASE_SECRET_KEY=
# SUPABASE_URL=https://<project-ref>.supabase.co
# STORAGE_BUCKET=sources

# Optional
# One model per job (left empty: gemini-2.5-flash)
PARSER_MODEL=gemini-4-hydrogen
WRITER_MODEL=gemini-4-carbon
ANSWER_MODEL=gemini-4-carbon
LINT_MODEL=gemini-4-carbon
SUGGEST_MODEL=gemini-4-carbon
GEMINI_EMBED_MODEL=gemini-embedding-001
LLM_CONCURRENCY=4
JOB_WORKERS=2
