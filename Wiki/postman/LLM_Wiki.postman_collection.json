{
  "info": {
    "name": "LLM Wiki API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set collection variables apiKey (API_KEY from Wiki/.env) and wiki. Start: .venv\\Scripts\\python run.py (port 8001). Long operations return job_id; the test scripts store it in {{jobId}} \u2014 then run 'Get job'."
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "try { const j = pm.response.json();",
          "  if (j && j.job_id) pm.collectionVariables.set('jobId', j.job_id);",
          "  if (j && j.changeset_id) pm.collectionVariables.set('changesetId', j.changeset_id);",
          "  if (j && j.result && j.result.changeset_id) pm.collectionVariables.set('changesetId', j.result.changeset_id);",
          "  if (j && j.result && j.result.fix && j.result.fix.changeset_id) pm.collectionVariables.set('changesetId', j.result.fix.changeset_id);",
          "} catch (e) {}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "apiKey",
      "value": "change-me"
    },
    {
      "key": "wiki",
      "value": "ifrs9"
    },
    {
      "key": "slug",
      "value": "overview"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "changesetId",
      "value": ""
    },
    {
      "key": "version",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Wikis",
      "item": [
        {
          "name": "Create wiki",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/wikis",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"{{wiki}}\",\n  \"name\": \"IFRS 9 Wiki\",\n  \"description\": \"IFRS 9 Financial Instruments knowledge base\"\n}"
            }
          }
        },
        {
          "name": "List wikis",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/wikis",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis"
              ]
            }
          }
        },
        {
          "name": "Get wiki",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/wikis/{{wiki}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis",
                "{{wiki}}"
              ]
            }
          }
        },
        {
          "name": "Get schema",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/wikis/{{wiki}}/schema",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis",
                "{{wiki}}",
                "schema"
              ]
            }
          }
        },
        {
          "name": "Update schema",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/wikis/{{wiki}}/schema",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis",
                "{{wiki}}",
                "schema"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema_md\": \"# Wiki schema\\n\\n(paste full conventions doc here)\"\n}"
            }
          }
        },
        {
          "name": "Index.md",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/wikis/{{wiki}}/index.md",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis",
                "{{wiki}}",
                "index.md"
              ]
            }
          }
        },
        {
          "name": "Log.md",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/wikis/{{wiki}}/log.md",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis",
                "{{wiki}}",
                "log.md"
              ]
            }
          }
        },
        {
          "name": "Export zip (Obsidian vault)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/wikis/{{wiki}}/export.zip",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis",
                "{{wiki}}",
                "export.zip"
              ]
            },
            "description": "Use Send and Download."
          }
        },
        {
          "name": "Delete wiki",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/wikis/{{wiki}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wikis",
                "{{wiki}}"
              ]
            },
            "description": "Deletes everything in the wiki."
          }
        }
      ]
    },
    {
